{
  "name": "1dl-server",
  "version": "1.0.0",
  "description": "1dl project server part",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch './src/**/*' --ext 'ts' --ignore './src/__tests__/**/*' --exec 'dotenvx run -f .env -- npx ts-node ./src/bin/dev.ts'",
    "dev:http": "dotenvx run -f .env -- npx 'ts-node' './src/bin/www.ts'",
    "dev:ws": "dotenvx run -f .env -- npx 'ts-node' './src/bin/ws.ts'",
    "preview": "node ./esbuild.mjs && dotenvx run -f .env -- ./dist/dev.js",
    "preview:http": "node ./esbuild.mjs && dotenvx run -f .env -- ./dist/www.js",
    "preview:ws": "node ./esbuild.mjs && dotenvx run -f .env -- ./dist/ws.js",
    "build": "node ./esbuild.mjs",
    "init": "dotenvx run -f .env -- npx 'ts-node' 'src/scripts/init-database.ts'",
    "test": "dotenvx run -f .env.test -f .env -- npx jest"
  },
  "author": "vladislav chursin",
  "license": "MIT",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "redis": "^5.9.0",
    "supertest": "^7.1.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/redis": "^4.0.10",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "esbuild": "0.27.2",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
